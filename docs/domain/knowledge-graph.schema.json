{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowgate.local/schemas/knowledge-graph.schema.json",
  "title": "KnowGate Subject Knowledge Graph",
  "type": "object",
  "required": ["version", "id_format", "subjects"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id_format": {
      "type": "string",
      "const": "subject.domain.node"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subject"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["id", "name", "domains"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/domain"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "required": ["id", "name", "nodes"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "stage",
        "prerequisites",
        "mastery",
        "item_families",
        "boss_theme"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "pattern": "^g[0-9]+(-g[0-9]+)?$"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "mastery": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "item_families": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "boss_theme": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    }
  }
}

